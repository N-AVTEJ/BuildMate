# ==============================================================================
# BuildMate Production & Staging Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required)
# ------------------------------------------------------------------------------
# Hosted PostgreSQL connection string (Neon, Supabase, AWS RDS, etc.)
# IMPORTANT for Vercel/Serverless: Use a connection pooler URL (e.g. Neon pooled endpoint or Supabase port 6543)
DATABASE_URL="postgresql://user:password@your-neon-or-supabase-host:5432/buildmate?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Application Base URL (Required)
# ------------------------------------------------------------------------------
# Set to your production Vercel domain or custom domain (no trailing slash)
APP_URL="https://your-buildmate-app.vercel.app"

# ------------------------------------------------------------------------------
# 3. Session & Security Secret (Required)
# ------------------------------------------------------------------------------
# Generate a secure random string (minimum 32 characters), e.g. via `openssl rand -hex 32`
SESSION_SECRET="replace-with-a-very-secure-random-32-byte-hex-string"

# ------------------------------------------------------------------------------
# 4. Email Delivery with Resend (Required for Auth & Notifications)
# ------------------------------------------------------------------------------
# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY="re_your_resend_api_key"
# Sender email address (e.g., BuildMate <notifications@yourdomain.com> or onboarding@resend.dev for testing)
EMAIL_FROM="BuildMate <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 5. Upstash Redis Rate Limiting (Recommended for Production)
# ------------------------------------------------------------------------------
# Distributed rate limiting for serverless functions (https://console.upstash.com)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-rest-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Storage (Required for File Uploads & Payment Proofs)
# ------------------------------------------------------------------------------
# Cloudflare R2 S3-compatible credentials
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="buildmate-proofs"
# Optional custom R2 endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=""
